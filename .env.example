# Скопируй в .env и правь под себя. Любой параметр Settings переопределяется
# переменной с префиксом TRANSCRIPT_.

# Токен HuggingFace — нужен только для диаризации.
# 1. Создать: https://huggingface.co/settings/tokens
# 2. Принять условия модели: https://huggingface.co/pyannote/speaker-diarization-community-1
TRANSCRIPT_HF_TOKEN=

# ASR: large-v3 (точнее, по умолчанию) | turbo (быстрее, хуже на русском)
TRANSCRIPT_ASR_MODEL=large-v3

# LLM для перевода и саммари: qwen3.6-35b | qwen3-30b | qwen3-14b | qwen3-8b | qwen3-4b
# Без этой строки берётся самая большая модель, которая помещается в память этой
# машины: 48 ГБ → qwen3.6-35b, 24 → qwen3-30b, 16 → qwen3-14b, 8 → qwen3-8b.
# Размеры весов — 19.0, 16.0, 7.7, 4.3 и 2.1 ГБ; под них отводится три четверти
# памяти, столько же рекомендует Metal. Просить модель больше, чем влезает,
# можно — приложение предупредит и всё равно загрузит.
# Вне Apple Silicon модель живёт в видеопамяти, её размер мы пока не спрашиваем,
# и там берётся qwen3-8b — он целиком ложится в 16 ГБ VRAM.
# TRANSCRIPT_LLM_MODEL=qwen3.6-35b

# --- LLM на другой машине ---
# Приложение остаётся локальным: наружу уходит только текст транскрипта, аудио
# никуда не отправляется. Бэкенд `openai` — это не облако OpenAI, а её протокол:
# на нём говорят vLLM, llama.cpp server, LM Studio, TGI и Ollama.
# TRANSCRIPT_LLM_BACKEND=openai
# TRANSCRIPT_LLM_BASE_URL=http://192.168.1.50:8000/v1
# Имя модели здесь задаёт сервер, а не наш реестр коротких имён.
# TRANSCRIPT_LLM_MODEL=Qwen/Qwen3.6-35B-A3B
# TRANSCRIPT_LLM_API_KEY=
# Свёртка часовой лекции идёт минутами — обрыв посреди неё дороже ожидания.
# TRANSCRIPT_LLM_TIMEOUT=300

# Куда складывать результаты. По умолчанию — «Документы/Транскрипты»; папку
# создаёт установка ярлыка и первое открытие окна. Путь нужен абсолютный:
# относительный отсчитывается от рабочего каталога, а из Finder приложение
# стартует в корне — такой путь окно игнорирует и берёт умолчание.
# TRANSCRIPT_OUTPUT_DIR=/Users/имя/Documents/Лекции
